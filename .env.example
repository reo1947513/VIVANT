# 環境変数の雛形（値は入れない。実際の値は .env.local と Vercel に設定する）
#
# Vercel では Production と Preview の両方に設定すること。
# 片方だけだとプレビューだけ空になり、原因の切り分けに時間を取られる。

# Supabase プロジェクトの URL（https://<ref>.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=

# 公開してよいキー（sb_publishable_ で始まる）。ブラウザにも渡る
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# サーバー専用の秘密キー（sb_secret_ で始まる）。RLS を無視できるため絶対に公開しない。
# NEXT_PUBLIC_ を付けないこと（付けるとブラウザに配信される）
SUPABASE_SECRET_KEY=

# Supabase CLIのアカウント切り替え用（npm run supabase -- ...）。
# `supabase login`/`logout`によるアカウント切り替えを避け、このリポジトリ専用の
# アクセストークンでCLIを叩くための値。Supabaseダッシュボード右上のアカウントメニュー
# > Access Tokens で発行する。使い方: npm run supabase -- <supabase CLIへ渡す引数>
SUPABASE_ACCESS_TOKEN=

# 管理画面にログインできる唯一のメールアドレス
ADMIN_EMAIL=
